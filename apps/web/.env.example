# Copia este archivo con el nombre .env.local (en esta misma carpeta apps/web)
# y completa los dos valores. Los encuentras en Supabase con el botón "Connect"
# (arriba en el panel) o en Project Settings → Data API (URL) y → API Keys (clave).

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Si tu proyecto solo muestra la clave antigua "anon" (empieza con eyJ...),
# borra la línea de arriba y usa esta:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# NUNCA pongas aquí la clave "secret" (sb_secret_...) ni "service_role".
# Todo lo que empieza con NEXT_PUBLIC_ termina visible en el navegador.
