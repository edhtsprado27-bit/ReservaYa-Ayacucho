classDiagram
    direction TB

    class RutaReservas {
        <<route.ts>>
        +GET() Response
        +POST(request) Response
    }
    class ReservasCasosDeUso {
        <<aplicacion>>
        +verLocal(repo, slug)
        +verDisponibilidad(repo, localId, fecha)
        +reservarHorario(repo, datos)
        +verMisReservas(repo, id?)
        +cancelarReserva(repo, id, motivo?)
    }
    class PedidoReserva {
        +canchaId: string
        +inicio: string
        +fin: string
        +clave: string
    }
    class validarPedido {
        <<regla de dominio>>
        +validarPedido(x) PedidoReserva
    }
    class Reserva {
        +id: string
        +codigo: string
        +estado: EstadoReserva
        +inicio: string
        +fin: string
        +total: number
        +adelanto: number
        +vence: string
        +cancelable: boolean
    }
    class EstadoReserva {
        <<enumeration>>
        pending_payment
        payment_review
        confirmed
        completed
        no_show
        cancelled
        expired
    }
    class ReservasRepositorio {
        <<interface>>
        +leerLocal(slug) LocalPublico
        +disponibilidad(localId, fecha) Turno[]
        +reservar(pedido) ReservaCreada
        +misReservas(id?) Reserva[]
        +cancelar(id, motivo?) object
    }
    class SupabaseReservasRepositorio {
        -db: SupabaseClient
        +reservar(pedido) ReservaCreada
    }
    class Composicion {
        <<composicion.ts>>
        +reservasPublicas() ReservasRepositorio
        +reservasConSesion(db) ReservasRepositorio
    }

    RutaReservas --> ReservasCasosDeUso
    RutaReservas --> Composicion
    ReservasCasosDeUso --> ReservasRepositorio
    ReservasCasosDeUso ..> validarPedido
    validarPedido ..> PedidoReserva : «crea»
    ReservasRepositorio ..> Reserva
    Reserva --> EstadoReserva
    SupabaseReservasRepositorio ..|> ReservasRepositorio
    Composicion ..> SupabaseReservasRepositorio : «crea»
