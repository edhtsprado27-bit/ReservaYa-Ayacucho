flowchart TB
    usuarios["<b>Jugador · Dueño de cancha · Administrador</b><br/>[Personas]"]

    subgraph limite["ReservaYa Ayacucho [Sistema]"]
        web["<b>Aplicación web</b><br/>[Next.js · Vercel]<br/>Interfaz para jugadores,<br/>dueños y administrador"]
        api["<b>API ReservaYa</b><br/>[Node.js + NestJS · Render]<br/>API REST, reglas de negocio,<br/>tareas programadas<br/>Monolito modular"]
        bd[("<b>Base de datos</b><br/>[PostgreSQL + PostGIS · Supabase]<br/>Usuarios, locales con ubicación,<br/>canchas, reservas y pagos")]
        cache[("<b>Caché y bloqueos</b><br/>[Redis · Upstash]<br/>Bloqueo de horarios y<br/>disponibilidad en memoria")]
        storage[("<b>Almacenamiento de archivos</b><br/>[Supabase Storage]<br/>Comprobantes y fotos")]
    end

    openrouter["<b>OpenRouter</b><br/>[Sistema externo]<br/>Modelos de IA"]
    correo["<b>Servicio de correo</b><br/>[Sistema externo]"]
    maps["<b>Google Maps</b><br/>[Sistema externo]<br/>Mapa y geocodificación"]
    waze["<b>Waze</b><br/>[Sistema externo]"]

    usuarios -- "Usa [HTTPS]" --> web
    web -- "Llama a la API<br/>[HTTPS/JSON]" --> api
    api -- "Lee y escribe<br/>[SQL/TCP]" --> bd
    api -- "Bloquea horarios<br/>[TCP]" --> cache
    api -- "Sube comprobantes<br/>[HTTPS/REST]" --> storage
    api -- "IA [HTTPS/REST]" --> openrouter
    api -- "Notifica [HTTPS/REST]" --> correo
    api -- "Geocodifica [HTTPS/REST]" --> maps
    web -- "Carga el mapa [HTTPS]" --> maps
    web -. "Enlace «Cómo llegar»" .-> waze

    classDef persona fill:#08427b,stroke:#052e56,color:#fff
    classDef contenedor fill:#438dd5,stroke:#2e6295,color:#fff
    classDef externo fill:#999999,stroke:#6b6b6b,color:#fff
    class usuarios persona
    class web,api,bd,cache,storage contenedor
    class openrouter,correo,maps,waze externo
    style limite fill:none,stroke:#444,stroke-dasharray:6 4
