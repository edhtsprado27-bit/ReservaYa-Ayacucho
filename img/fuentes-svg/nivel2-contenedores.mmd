flowchart TB
    usuarios["<b>Jugador · Dueño de cancha · Administrador</b><br/>[Personas]"]

    subgraph limite["ReservaYa Ayacucho [Sistema]"]
        web["<b>Aplicación web</b><br/>[Next.js 16 · navegador]<br/>Mapa, grilla de horarios,<br/>paneles del dueño y admin,<br/>chat del asistente,<br/>enlaces de WhatsApp"]
        srv["<b>Servidor de la aplicación</b><br/>[Next.js 16 en Vercel]<br/>Páginas + API REST /api<br/>Monolito modular (9 módulos)"]
        cdn["<b>CDN</b><br/>[Vercel]<br/>Catálogo 60 s · grilla 5 s"]
        bd[("<b>Base de datos</b><br/>[PostgreSQL · Supabase]<br/>Funciones fn_*, RLS,<br/>EXCLUDE anti doble reserva")]
        auth[("<b>Autenticación</b><br/>[Supabase Auth]<br/>Cuentas y sesiones")]
        storage[("<b>Almacenamiento</b><br/>[Supabase Storage]<br/>Capturas (bucket privado)")]
    end

    openrouter["<b>OpenRouter</b><br/>[Sistema externo]<br/>Modelos de IA"]
    osm["<b>OpenStreetMap</b><br/>[Sistema externo]"]
    whatsapp["<b>WhatsApp</b><br/>[Sistema externo]<br/>Solo enlaces wa.me"]

    usuarios -- "Usa [HTTPS]" --> web
    web -- "Páginas y API<br/>[HTTPS/JSON]" --> cdn
    cdn --> srv
    web -- "Inicia sesión [HTTPS]" --> auth
    web -- "Teselas [HTTPS]" --> osm
    srv -- "Funciones fn_*<br/>[HTTPS · PostgREST]" --> bd
    srv -- "Sesión" --> auth
    srv -- "Sube capturas<br/>[HTTPS]" --> storage
    srv -- "Lee comprobantes y<br/>entiende mensajes del asistente<br/>[HTTPS/REST]" --> openrouter
    usuarios -. "Abren el chat<br/>(enlace)" .-> whatsapp

    classDef persona fill:#08427b,stroke:#052e56,color:#fff
    classDef contenedor fill:#438dd5,stroke:#2e6295,color:#fff
    classDef externo fill:#999999,stroke:#6b6b6b,color:#fff
    class usuarios persona
    class web,srv,cdn,bd,auth,storage contenedor
    class openrouter,osm,whatsapp externo
    style limite fill:none,stroke:#444,stroke-dasharray:6 4
