classDiagram
    direction TB

    class ReservaController {
        -crearReserva: CrearReservaUseCase
        +crear(dto, req) Respuesta
    }
    class CrearReservaUseCase {
        -reservas: ReservaRepository
        -bloqueo: BloqueoHorarioPort
        -tarifas: TarifaPort
        +ejecutar(cmd) Reserva
    }
    class MarcarEnVerificacionUseCase {
        +ejecutar(reservaId) void
    }
    class Reserva {
        +id: string
        +jugadorId: string
        +canchaId: string
        -estado: EstadoReserva
        +expiraEn: Date
        +crear(jugadorId, canchaId, franja, precio)$ Reserva
        +total() number
        +registrarComprobante() void
        +cancelar() void
    }
    class FranjaHoraria {
        +fecha: string
        +horaInicio: number
        +horaFin: number
        +horas() number[]
    }
    class EstadoReserva {
        <<enumeration>>
        PENDIENTE_PAGO
        EN_VERIFICACION
        CONFIRMADA
        RECHAZADA
        CANCELADA
        EXPIRADA
    }
    class ReservaRepository {
        <<interface>>
        +guardar(reserva) void
        +buscarPorId(id) Reserva
    }
    class BloqueoHorarioPort {
        <<interface>>
        +bloquear(canchaId, franja, ms) boolean
        +liberar(canchaId, franja) void
    }
    class TarifaPort {
        <<interface>>
        +precioPorHora(canchaId, franja) number
    }
    class PostgresReservaRepository
    class RedisBloqueoHorarioAdapter
    class HorariosTarifaAdapter

    class PagoController {
        +subirComprobante(id, archivo)
        +validar(id, decision)
    }
    class RegistrarComprobanteUseCase {
        -storage: ComprobanteStoragePort
        -verificador: VerificadorComprobantePort
        +ejecutar(reservaId, imagen) ResultadoVerificacion
    }
    class ValidarPagoUseCase {
        +ejecutar(pagoId, aprobado) void
    }
    class ComprobanteStoragePort {
        <<interface>>
        +guardar(imagen) string
    }
    class VerificadorComprobantePort {
        <<interface>>
        +verificar(urlImagen, montoEsperado) ResultadoVerificacion
    }
    class ResultadoVerificacion {
        <<DTO>>
        +coincide: boolean
        +monto: number
        +numeroOperacion: string
        +motivo: string
    }
    class SupabaseStorageAdapter
    class IaComprobanteAdapter

    ReservaController --> CrearReservaUseCase
    CrearReservaUseCase --> ReservaRepository
    CrearReservaUseCase --> BloqueoHorarioPort
    CrearReservaUseCase --> TarifaPort
    CrearReservaUseCase ..> Reserva : «crea»
    Reserva *-- FranjaHoraria
    Reserva --> EstadoReserva
    PostgresReservaRepository ..|> ReservaRepository
    RedisBloqueoHorarioAdapter ..|> BloqueoHorarioPort
    HorariosTarifaAdapter ..|> TarifaPort

    PagoController --> RegistrarComprobanteUseCase
    PagoController --> ValidarPagoUseCase
    RegistrarComprobanteUseCase --> ComprobanteStoragePort
    RegistrarComprobanteUseCase --> VerificadorComprobantePort
    RegistrarComprobanteUseCase --> MarcarEnVerificacionUseCase : API pública de Reservas
    VerificadorComprobantePort ..> ResultadoVerificacion
    SupabaseStorageAdapter ..|> ComprobanteStoragePort
    IaComprobanteAdapter ..|> VerificadorComprobantePort
