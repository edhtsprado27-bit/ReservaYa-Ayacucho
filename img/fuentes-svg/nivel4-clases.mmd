classDiagram
    direction TB

    class ReservasRepositorio {
        <<interface>>
        +leerLocal(slug) LocalPublico
        +disponibilidad(localId, fecha) Turno[]
        +reservar(pedido) ReservaCreada
        +misReservas(id?) Reserva[]
        +cancelar(id, motivo?) object
    }
    class SupabaseReservasRepositorio {
        -db: SupabaseClient
    }
    class ReservasCasosDeUso {
        <<aplicacion>>
        +reservarHorario(repo, datos)
        +cancelarReserva(repo, id, motivo?)
        +verMisReservas(repo, id?)
    }
    class PedidoReserva {
        +canchaId: string
        +inicio: string
        +fin: string
        +clave: string
    }

    class enviarComprobante {
        <<caso de uso>>
        +enviarComprobante(deps, reservaId, metodo, imagen) PagoEnviado
    }
    class PagosCasosDeUso {
        <<aplicacion>>
        +revisarPago(pagos, id, aprobar, motivo?)
        +verPagosPorRevisar(pagos, almacen)
    }
    class PagosRepositorio {
        <<interface>>
        +estadoPago(reservaId) EstadoPago
        +configIA() ConfigIA
        +registrarPago(nuevo) PagoEnviado
        +revisarPago(id, aprobar, motivo?)
    }
    class AlmacenComprobantes {
        <<interface>>
        +subir(ruta, imagen, mime) ResultadoSubida
        +enlacesFirmados(rutas, segundos) Map
    }
    class LectorComprobantes {
        <<interface>>
        +leer(imagen, mime, config) ResultadoOCR
    }
    class SupabasePagosRepositorio
    class SupabaseAlmacenComprobantes
    class OpenRouterLectorComprobantes
    class ReglasVerificacion {
        <<dominio>>
        +destinatarioCoincide(leido, titular)
        +montoLimpio(m)
        +validarLectura(x)
        +tipoDeImagen(bytes)
    }

    ReservasCasosDeUso --> ReservasRepositorio
    ReservasCasosDeUso ..> PedidoReserva : «valida»
    SupabaseReservasRepositorio ..|> ReservasRepositorio

    enviarComprobante --> PagosRepositorio
    enviarComprobante --> AlmacenComprobantes
    enviarComprobante --> LectorComprobantes
    enviarComprobante ..> ReglasVerificacion
    PagosCasosDeUso --> PagosRepositorio
    PagosCasosDeUso --> AlmacenComprobantes
    SupabasePagosRepositorio ..|> PagosRepositorio
    SupabaseAlmacenComprobantes ..|> AlmacenComprobantes
    OpenRouterLectorComprobantes ..|> LectorComprobantes
