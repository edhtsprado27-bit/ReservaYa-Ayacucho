flowchart TB
    web["<b>Aplicación web</b><br/>[Next.js]"]

    subgraph srv["Servidor de la aplicación [Contenedor · Next.js en Vercel]"]
        rest["<b>API REST</b><br/>app/api/**/route.ts<br/>10 rutas"]
        proxy["<b>Proxy de sesión</b><br/>src/proxy.ts"]
        cuentas["<b>Cuentas</b><br/>Perfil y roles"]
        catalogo["<b>Catálogo</b><br/>Canchas publicadas (caché),<br/>registro y aprobación"]
        reservas["<b>Reservas</b><br/>Grilla, reservar,<br/>mis reservas, cancelar"]
        pagos["<b>Pagos</b><br/>Comprobante, IA,<br/>revisión del dueño"]
        comp["<b>Compartido</b><br/>Errores, validaciones,<br/>clientes de Supabase"]
    end

    bd[("<b>Base de datos</b><br/>[PostgreSQL · Supabase]")]
    auth[("<b>Supabase Auth</b>")]
    storage[("<b>Supabase Storage</b>")]
    openrouter["<b>OpenRouter</b><br/>[Sistema externo]"]

    web -- "HTTPS/JSON" --> rest
    web --> proxy
    rest --> catalogo & reservas & pagos
    proxy --> auth
    reservas -. "dominio" .-> catalogo
    catalogo & reservas & pagos & cuentas -.-> comp

    catalogo -- "Repository + Decorator" --> bd
    reservas -- "Repository · fn_reservar" --> bd
    pagos -- "Repository" --> bd
    pagos -- "Adapter" --> storage
    pagos -- "Adapter · HTTPS" --> openrouter
    cuentas --> auth

    classDef contenedor fill:#438dd5,stroke:#2e6295,color:#fff
    classDef componente fill:#85bbf0,stroke:#5d82a8,color:#000
    classDef externo fill:#999999,stroke:#6b6b6b,color:#fff
    class web,bd,auth,storage contenedor
    class rest,proxy,cuentas,catalogo,reservas,pagos,comp componente
    class openrouter externo
    style srv fill:none,stroke:#444,stroke-dasharray:6 4
