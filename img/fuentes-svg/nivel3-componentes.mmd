flowchart TB
    web["<b>Aplicación web</b><br/>[Next.js]"]

    subgraph srv["Servidor de la aplicación [Contenedor · Next.js en Vercel]"]
        direction TB
        rest["<b>API REST</b><br/>app/api/**/route.ts<br/>24 rutas · 30 operaciones"]
        proxy["<b>Proxy de sesión</b><br/>src/proxy.ts"]
        subgraph mods["Módulos (src/modules) · cada uno con Clean Architecture"]
            direction TB
            subgraph fila1[" "]
                direction LR
                reservas["<b>Reservas</b><br/>Grilla, reservar,<br/>mis reservas, cancelar"]
                locales["<b>Locales</b><br/>Reglas, servicios, canchas;<br/>control del admin"]
                catalogo["<b>Catálogo</b><br/>Canchas publicadas (caché),<br/>registro y aprobación"]
                agenda["<b>Agenda</b><br/>Reservas por teléfono,<br/>cobros y bloqueos"]
                reservas -. "dominio" .-> catalogo
                locales -. "renueva el mapa" .-> catalogo
            end
            subgraph fila2[" "]
                direction LR
                cuentas["<b>Cuentas</b><br/>Perfil, roles y<br/>cuenta suspendida"]
                pagos["<b>Pagos</b><br/>Comprobante, IA,<br/>revisión del dueño"]
                usuarios["<b>Usuarios</b><br/>Rol, suspender<br/>y reactivar"]
                soporte["<b>Soporte</b><br/>WhatsApp de ayuda<br/>(use cache)"]
                asistente["<b>Asistente</b><br/>Reglas + IA; horas libres<br/>reales del catálogo y la grilla"]
                cuentas ~~~ pagos ~~~ usuarios ~~~ soporte ~~~ asistente
            end
            fila1 ~~~ fila2
        end
        comp["<b>Compartido</b><br/>Errores, validaciones, clientes de Supabase,<br/>enlaces de WhatsApp (wa.me), cliente de OpenRouter"]
    end

    bd[("<b>Base de datos</b><br/>[PostgreSQL · Supabase]<br/>funciones fn_*")]
    auth[("<b>Supabase Auth</b>")]
    storage[("<b>Supabase Storage</b>")]
    openrouter["<b>OpenRouter</b><br/>[Sistema externo]"]

    web -- "HTTPS/JSON" --> rest
    web --> proxy
    rest -- "casos de uso" --> mods
    mods -. "importan" .-> comp
    mods -- "Repository (todos)<br/>+ Decorator (Catálogo, Locales)" --> bd
    mods -- "Pagos · Adapter" --> storage
    mods -- "Pagos y Asistente · Adapter · HTTPS" --> openrouter
    mods -- "Cuentas" --> auth
    proxy --> auth

    classDef contenedor fill:#438dd5,stroke:#2e6295,color:#fff
    classDef componente fill:#85bbf0,stroke:#5d82a8,color:#000
    classDef externo fill:#999999,stroke:#6b6b6b,color:#fff
    class web,bd,auth,storage contenedor
    class rest,proxy,cuentas,catalogo,reservas,pagos,agenda,locales,usuarios,soporte,asistente,comp componente
    class openrouter externo
    style srv fill:none,stroke:#444,stroke-dasharray:6 4
    style mods fill:#f4f8fc,stroke:#5d82a8
    style fila1 fill:none,stroke:none
    style fila2 fill:none,stroke:none
